# Copy this file to .env and fill in real values before starting the stack.
# NEVER commit .env with real secrets.

# --- Auth ---
AUTH_SECRET_KEY=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
AUTH_TOKEN_EXPIRY_HOURS=4
RBAC_ADMIN_USER=admin
RBAC_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Datastores ---
ELASTIC_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
NEO4J_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- JVM ---
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Crawler ---
START_URL=https://www.torproject.org
ALLOWED_DOMAINS=www.torproject.org,support.torproject.org,community.torproject.org
MAX_PAGES=250
PLAYWRIGHT_TIMEOUT_MS=30000
CAPTCHA_SOLVER_ENABLED=true
CAPTCHA_2_KEY=REPLACE_WITH_2CAPTCHA_API_KEY

# --- Queue names (defaults are fine) ---
RAW_QUEUE_NAME=raw_html
RAW_DLQ_QUEUE=raw_html_dlq
SANITIZED_QUEUE_NAME=sanitized_text
SANITIZED_DLQ_QUEUE=sanitized_text_dlq

# --- Brain / ML ---
ELASTIC_INDEX=intel-data-v3
SCHEMA_VERSION=v1
MODEL_VERSION=risk-ml-v1
SCORING_STRATEGY=auto
RISK_MODEL_PATH=/app/models/risk_model.joblib
MIN_TEXT_LEN=80

# --- UI ---
ACTIVE_UI_UPSTREAM=dashboard-ui:80
